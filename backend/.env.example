# 本地开发配置。复制为 .env 即可生效：cp .env.example .env
#
# 真实环境变量优先于本文件，本文件只填补空缺。因此生产不用它 ——
# 生产由 systemd 的 EnvironmentFile 注入（见 deploy/api.env.example）。
#
# .env 已在 .gitignore 中，绝不要提交。

APP_ADDR=127.0.0.1:8080

# dev 放宽 Cookie 的 Secure 要求，并允许省略 MASTER_KEY。
APP_ENV=dev

# ---- 数据库: 两种都支持, 二选一, 切换只需改这里 ----
#
# 代码层面 sqlite 与 postgres 完全等价: 一套 SQL 跑两种库, 差异只有取任务的
# 加锁子句 (FOR UPDATE SKIP LOCKED) 与占位符改写两处, 由 store 内部处理。
#
# 但并发与锁的语义在 SQLite 上无法验证 —— SQLite 同一时刻只允许一个写事务,
# 调度器抢任务的竞争在它上面永远不会真正发生。因此本地跑通不等于生产跑通,
# 上线前必须在 PostgreSQL 上验证一遍。

# 本地开发: SQLite, 免部署, 文件放在 ./data 下
DATABASE_URL=sqlite://./data/app.db

# 服务器: PostgreSQL。启用时注释掉上面那行, 取消下面这行的注释。
# 用户名、密码、库名按实际填写; 同机连接用 sslmode=disable, 跨机务必改成 require。
# DATABASE_URL=postgres://outlook:CHANGE_ME@127.0.0.1:5432/outlook_console?sslmode=disable
#
# 首次使用 PostgreSQL 前需要先建角色与库 (在数据库所在机器上执行):
#   CREATE ROLE outlook LOGIN PASSWORD '改成强密码';
#   CREATE DATABASE outlook_console OWNER outlook;
# 建表由程序启动时自动迁移, 不需要手工导入 schema。

# 32 字节主密钥，openssl rand -hex 32 生成。
# 开发模式留空会回落到内置固定密钥，方便重启后仍能解开本地数据。
# 一旦在生产启用便不可更改：改了之后已存的令牌全部无法解密。
# MASTER_KEY=

# 会话签名密钥，不填则从主密钥派生。
# SESSION_KEY=

# 所有对微软的请求都经由这里，留空表示直连。
# OUTBOUND_PROXY=http://127.0.0.1:7890

# 租户段：个人账号 consumers，个人与企业混合 common，企业填租户 GUID。
MS_TENANT=consumers

# 轮换阈值，范围 30 到 75 天。90 天是硬上限，默认留 30 天余量。
ROTATE_AFTER_DAYS=60

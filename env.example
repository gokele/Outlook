# 配置模板。这是仓库里唯一一份配置说明，本地与生产都以它为准。
#
# 本地开发：复制到 backend 目录下改名为 .env 即可生效
#
#     cp env.example backend/.env
#
# 生产：把需要的项通过环境变量注入，或复制成一个文件用 systemd 的
# EnvironmentFile 指过去。含主密钥，权限必须是 0600。
#
# 真实环境变量优先于文件，文件只填补空缺 —— 因此容器或 systemd 里注入的
# 变量仍然盖得过文件，不必担心文件里的旧值悄悄生效。
#
# .env 已在 .gitignore 中，绝不要提交。本文件不含任何真实密钥，可以提交。

APP_ADDR=127.0.0.1:8080

# dev 放宽 Cookie 的 Secure 要求。留空时按监听地址推断：
# 只监听回环视为本机自用（dev），监听其它地址视为对外服务（prod）。
APP_ENV=dev

# ---- 数据库: 两种都支持, 二选一, 切换只需改这里 ----
#
# 代码层面 sqlite 与 postgres 完全等价: 一套 SQL 跑两种库, 差异只有取任务的
# 加锁子句 (FOR UPDATE SKIP LOCKED) 与占位符改写两处, 由 store 内部处理。
#
# 但并发与锁的语义在 SQLite 上无法验证 —— SQLite 同一时刻只允许一个写事务,
# 调度器抢任务的竞争在它上面永远不会真正发生。因此本地跑通不等于生产跑通,
# 上线前必须在 PostgreSQL 上验证一遍。

# 本地开发: SQLite, 免部署, 文件放在 ./data 下
DATABASE_URL=sqlite://./data/app.db

# 服务器: PostgreSQL。启用时注释掉上面那行, 取消下面这行的注释。
# 用户名、密码、库名按实际填写; 同机连接用 sslmode=disable, 跨机务必改成 require。
# DATABASE_URL=postgres://outlook:CHANGE_ME@127.0.0.1:5432/outlook_console?sslmode=disable
#
# 首次使用 PostgreSQL 前需要先建角色与库 (在数据库所在机器上执行):
#   CREATE ROLE outlook LOGIN PASSWORD '改成强密码';
#   CREATE DATABASE outlook_console OWNER outlook;
# 建表由程序启动时自动迁移, 不需要手工导入 schema。

# 32 字节主密钥。**不填也不要紧**：首次启动会自动生成一把随机的写进 .env。
# 想自己指定时用 openssl rand -hex 32 生成。
#
# 没有任何内置的默认密钥 —— 曾经有过一个，它随源码公开，
# 用它加密的库一旦泄露等于没有加密。现在缺了就是启动失败，不会凑合。
#
# 一旦启用便不可更改：改了之后已存的令牌全部无法解密，只能重新导入全部账号。
# 务必备份。
# MASTER_KEY=

# 会话签名密钥，不填则从主密钥派生。
# SESSION_KEY=

# ---- 反向代理：谁有资格代填「来源 IP」 ----
#
# 只有当 TCP 连接本身来自这里列出的地址时，X-Forwarded-For / X-Real-IP
# 才会被采信；其他情况一律以 TCP 连接地址为准。
#
# 这一条是两个安全控制的地基：API Key 的 IP 白名单，以及登录失败限速。
# 少了它，任何人加一个请求头就能冒充白名单里的 IP，
# 或者每次换一个伪造 IP 让限速永远数不满。
#
# 默认只信本机回环，对应「Nginx 与本服务装在同一台机器上」这种最常见的部署。
# 反代在另一台机器上时，把那台机器的地址填进来（支持 IP 或 CIDR，逗号分隔）。
# 本服务直接对外、前面没有任何反代时，填空字符串最安全。
TRUSTED_PROXIES=127.0.0.0/8,::1/128

# 所有对微软的请求都经由这里，留空表示直连。
# OUTBOUND_PROXY=http://127.0.0.1:7890

# 租户段：个人账号 consumers，个人与企业混合 common，企业填租户 GUID。
MS_TENANT=consumers

# 轮换阈值，范围 30 到 75 天。90 天是硬上限，默认留 30 天余量。
ROTATE_AFTER_DAYS=60
